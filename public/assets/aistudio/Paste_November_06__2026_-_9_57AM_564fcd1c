                  <div>
                    <label className="text-xs text-zinc-400">SKU Code</label>
                    <input
                      type="text"
                      value={productForm.sku}
                      onChange={(e) => setProductForm({ ...productForm, sku: e.target.value })}
                      className="mt-1 w-full bg-[#1A1E27] px-3.5 py-2 text-xs rounded-lg border border-[#2B303E] text-white font-mono focus:outline-none focus:border-[#D4AF37]"
                    />
                  </div>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label className="text-xs text-zinc-400">Department</label>
                    <select
                      value={productForm.category}
                      onChange={(e) => setProductForm({ ...productForm, category: e.target.value })}
                      className="mt-1 w-full bg-[#1A1E27] px-3.5 py-2 text-xs rounded-lg border border-[#2B303E] text-white focus:outline-none focus:border-[#D4AF37]"
                    >
                      <option>Rings</option>
                      <option>Necklaces</option>
                      <option>Earrings</option>
