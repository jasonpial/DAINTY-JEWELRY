                        className="flex-1 bg-[#181C26] px-4 py-2.5 text-xs rounded-lg border border-[#2C3241] focus:outline-none focus:border-[#D4AF37] text-white"
                      />
                      <button
                        type="submit"
                        className="flex items-center gap-2 px-5 py-2.5 bg-[#D4AF37] hover:bg-[#E2BE4B] text-black text-xs font-semibold rounded-lg transition-colors"
