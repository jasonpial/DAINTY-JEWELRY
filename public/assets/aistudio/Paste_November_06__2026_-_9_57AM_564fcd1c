              {/* Pricing & Vault Inventory */}
              <div className="space-y-4 pt-4 border-t border-[#232732]">
                <h4 className="text-xs font-semibold text-[#D4AF37] uppercase tracking-wider">
                  3. Pricing & Vault Thresholds
                </h4>
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
                  <div>
                    <label className="text-xs text-zinc-400">Retail Price ($) *</label>
                    <input
                      type="number"
                      required
                      value={productForm.price}
                      onChange={(e) => setProductForm({ ...productForm, price: e.target.value })}
                      className="mt-1 w-full bg-[#1A1E27] px-3 py-2 text-xs rounded-lg border border-[#2B303E] text-white font-mono focus:outline-none focus:border-[#D4AF37]"
                    />
                  </div>
                  <div>
                    <label className="text-xs text-zinc-400">Artisan Cost ($)</label>
                    <input
                      type="number"
                      value={productForm.cost}
                      onChange={(e) => setProductForm({ ...productForm, cost: e.target.value })}
                      className="mt-1 w-full bg-[#1A1E27] px-3 py-2 text-xs rounded-lg border border-[#2B303E] text-white font-mono focus:outline-none focus:border-[#D4AF37]"
                    />
                  </div>
                  <div>
                    <label className="text-xs text-zinc-400">Units in Stock</label>
                    <input
                      type="number"
                      value={productForm.stock}
                      onChange={(e) => setProductForm({ ...productForm, stock: e.target.value })}
                      className="mt-1 w-full bg-[#1A1E27] px-3 py-2 text-xs rounded-lg border border-[#2B303E] text-white font-mono focus:outline-none focus:border-[#D4AF37]"
                    />
                  </div>
                  <div>
                    <label className="text-xs text-zinc-400">Alert Min. Threshold</label>
                    <input
                      type="number"
                      value={productForm.threshold}
                      onChange={(e) => setProductForm({ ...productForm, threshold: e.target.value })}
                      className="mt-1 w-full bg-[#1A1E27] px-3 py-2 text-xs rounded-lg border border-[#2B303E] text-white font-mono focus:outline-none focus:border-[#D4AF37]"
                    />
                  </div>
                </div>

                <div>
                  <label className="text-xs text-zinc-400">Description / Provenance Notes</label>
                  <textarea
                    rows={2}
                    value={productForm.description}
                    onChange={(e) => setProductForm({ ...productForm, description: e.target.value })}
                    placeholder="Handcrafted details, provenance of stones, hallmarking..."
                    className="mt-1 w-full bg-[#1A1E27] p-3 text-xs rounded-lg border border-[#2B303E] text-white focus:outline-none focus:border-[#D4AF37]"
                  />
                </div>
              </div>

              {/* Submit Buttons */}
              <div className="pt-4 border-t border-[#232732] flex items-center justify-end gap-3">
                <button
                  type="button"
                  onClick={() => setIsProductModalOpen(false)}
                  className="px-4 py-2 text-xs text-zinc-400 hover:text-white rounded-lg transition-colors"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-6 py-2.5 text-xs font-semibold text-black bg-[#D4AF37] hover:bg-[#E3BF4C] rounded-lg shadow-md transition-all uppercase tracking-wider"
                >
                  {editingProduct ? 'Save Modifications' : 'Commit to Maison Catalog'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* =========================================================================
          MODAL 2: VIEW ORDER DETAILS & FULFILLMENT MODAL
         ========================================================================= */}
      {viewingOrder && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-fade-in">
          <div className="relative w-full max-w-2xl bg-[#14171E] rounded-xl border border-[#D4AF37]/30 shadow-2xl overflow-hidden">
            {/* Header */}
            <div className="px-6 py-4 border-b border-[#262A33] flex items-center justify-between">
              <div>
                <span className="text-[10px] uppercase font-mono text-[#D4AF37]">
                  Order Dossier
                </span>
                <h3 className="font-serif text-lg text-white font-medium">{viewingOrder.id}</h3>
              </div>
              <button
                onClick={() => setViewingOrder(null)}
                className="p-1 rounded text-zinc-400 hover:text-white"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="p-6 space-y-6">
              {/* Client & Shipping */}
              <div className="grid grid-cols-2 gap-4 p-4 rounded-lg bg-[#181C26] border border-[#282D3B]">
                <div>
                  <p className="text-[11px] text-zinc-400 uppercase tracking-wider">Client Details</p>
                  <p className="text-sm font-medium text-white mt-1">{viewingOrder.customer}</p>
                  <p className="text-xs text-zinc-400">{viewingOrder.email}</p>
                </div>
                <div>
                  <p className="text-[11px] text-zinc-400 uppercase tracking-wider">Shipping Method</p>
                  <p className="text-xs font-medium text-[#D4AF37] mt-1">{viewingOrder.shippingMethod}</p>
                  <p className="text-xs text-zinc-400 mt-1 line-clamp-2">
                    {viewingOrder.shippingAddress}
                  </p>
                </div>
              </div>

              {/* Items Breakdown with Engravings */}
              <div>
                <h4 className="text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-3">
                  Jewelry Creations in Order
                </h4>
                <div className="space-y-3">
                  {viewingOrder.items.map((item, idx) => (
                    <div
                      key={idx}
                      className="p-3.5 rounded-lg bg-[#191D27] border border-[#2B303F] flex items-center justify-between"
                    >
                      <div>
                        <p className="text-sm font-medium text-white">{item.name}</p>
                        <p className="text-xs text-zinc-400">
                          Finger Size / Length: <span className="text-zinc-200">{item.size}</span>
                        </p>
                        {item.engraving !== 'None' && (
                          <div className="flex items-center gap-1.5 mt-1 text-xs text-[#E8D5A0]">
                            <Sparkles className="w-3 h-3 text-[#D4AF37]" />
                            <span>Custom Engraving: {item.engraving}</span>
                          </div>
                        )}
                      </div>
                      <div className="text-right">
                        <p className="text-sm font-mono text-white font-medium">
                          ${item.price.toLocaleString()}
                        </p>
                        <p className="text-xs text-zinc-500">Qty: {item.qty}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Phase Progression */}
              <div>
                <h4 className="text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-3">
                  Update Workshop / Transit Phase
                </h4>
                <div className="flex flex-wrap gap-2">
                  {['Processing', 'Engraving / Workshop', 'Shipped', 'Delivered'].map((status) => (
                    <button
                      key={status}
                      onClick={() => handleUpdateOrderStatus(viewingOrder.id, status)}
                      className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                        viewingOrder.fulfillmentStatus === status
                          ? 'bg-[#D4AF37] text-black font-semibold'
                          : 'bg-[#1E232E] text-zinc-300 hover:text-white border border-[#2E3342]'
                      }`}
                    >
                      {status}
                    </button>
                  ))}
                </div>
              </div>

              {/* Financial Total */}
              <div className="pt-4 border-t border-[#232732] flex items-center justify-between">
                <div>
                  <span className="text-xs text-zinc-400">Payment Status: </span>
                  <span className="text-xs font-semibold text-emerald-400">{viewingOrder.paymentStatus}</span>
                </div>
                <div className="text-right">
                  <span className="text-xs text-zinc-400 mr-2">Total Settled:</span>
                  <span className="text-xl font-mono font-bold text-white">
                    ${viewingOrder.total.toLocaleString()}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}