                      </p>
                    </div>
                    <span className="text-xs px-2.5 py-1 bg-[#202532] text-[#D4AF37] rounded border border-[#D4AF37]/30">
                      {selectedInquiry.tag}
                    </span>
                  </div>

                  {/* Conversation Body */}
