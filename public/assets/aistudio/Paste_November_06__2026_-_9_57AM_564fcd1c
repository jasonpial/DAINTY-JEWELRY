// --- MAIN APPLICATION COMPONENT ---
export default function App() {
  const [activeTab, setActiveTab] = useState('overview');
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [products, setProducts] = useState(INITIAL_PRODUCTS);
  const [orders, setOrders] = useState(INITIAL_ORDERS);
  const [inquiries, setInquiries] = useState(INITIAL_INQUIRIES);

  // Search & Filters
  const [productSearch, setProductSearch] = useState('');
  const [selectedCategoryFilter, setSelectedCategoryFilter] = useState('All');
  const [orderSearch, setOrderSearch] = useState('');
  const [orderStatusFilter, setOrderStatusFilter] = useState('All');

  // Modals & Sliders
  const [isProductModalOpen, setIsProductModalOpen] = useState(false);
  const [editingProduct, setEditingProduct] = useState(null);
  const [viewingOrder, setViewingOrder] = useState(null);
  const [selectedInquiry, setSelectedInquiry] = useState(INITIAL_INQUIRIES[0]);
  const [replyText, setReplyText] = useState('');

  // Toast system
  const [toast, setToast] = useState(null);

  const showToast = (message, type = 'success') => {
    setToast({ message, type });
    setTimeout(() => setToast(null), 3600);
  };

  // Form State for Add / Edit Product
  const [productForm, setProductForm] = useState({
    title: '',
    sku: '',
    category: 'Rings',
    collection: 'Bridal & Solitaire',
    metal: '18K Yellow Gold',
    gemstone: 'Natural Diamond',
    carat: '',
    cut: 'Round Brilliant (Ideal)',
    clarity: 'VVS1',
    color: 'D-F',
    price: '',
    cost: '',
    stock: '',
    threshold: 2,
    description: '',
    image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=400&q=80'
  });

  const openNewProductModal = () => {
    setEditingProduct(null);
    setProductForm({
      title: '',
      sku: `AUR-${Math.floor(100 + Math.random() * 900)}`,
      category: 'Rings',
      collection: 'Bridal & Solitaire',
      metal: '18K Yellow Gold',
      gemstone: 'Natural Diamond',
      carat: '1.50 ct',
      cut: 'Round Brilliant (Ideal)',
      clarity: 'VVS1',
      color: 'E',
      price: 5200,
      cost: 2600,
      stock: 5,
      threshold: 2,
      description: '',
      image: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=400&q=80'
    });
    setIsProductModalOpen(true);
  };

  const openEditProductModal = (product) => {
    setEditingProduct(product);
    setProductForm({
      title: product.name,
      sku: product.sku,
      category: product.category,
      collection: product.collection,
      metal: product.metal,
      gemstone: product.gemstone,
      carat: product.carat,
      cut: product.cut,
      clarity: product.clarity,
      color: product.color,
      price: product.price,
      cost: product.cost,
      stock: product.stock,
      threshold: product.threshold,
      description: product.description,
      image: product.image
    });
    setIsProductModalOpen(true);
  };

  const handleSaveProduct = (e) => {
    e.preventDefault();
    if (!productForm.title || !productForm.price) {
      showToast('Please provide diamond or jewelry name and price', 'error');
      return;
    }

    const priceNum = Number(productForm.price);
    const stockNum = Number(productForm.stock);
    const threshNum = Number(productForm.threshold);

    let status = 'In Stock';
    if (stockNum === 0) status = 'Sold Out';
    else if (stockNum <= threshNum) status = 'Low Stock';

    if (editingProduct) {
      setProducts((prev) =>
        prev.map((item) =>
          item.id === editingProduct.id
            ? {
                ...item,
                name: productForm.title,
                sku: productForm.sku,
                category: productForm.category,
                collection: productForm.collection,
                metal: productForm.metal,
                gemstone: productForm.gemstone,
                carat: productForm.carat,
                cut: productForm.cut,
                clarity: productForm.clarity,
                color: productForm.color,
                price: priceNum,
                cost: Number(productForm.cost),
                stock: stockNum,
                threshold: threshNum,
                status,
                description: productForm.description,
                image: productForm.image
              }
            : item
        )
      );
      showToast(`Piece "${productForm.title}" updated successfully.`);
    } else {
      const newProduct = {
        id: `PRD-00${products.length + 1}`,
        sku: productForm.sku,
        name: productForm.title,
        category: productForm.category,
        collection: productForm.collection,
        metal: productForm.metal,
        gemstone: productForm.gemstone,
        carat: productForm.carat,
        cut: productForm.cut,
        clarity: productForm.clarity,
        color: productForm.color,
        price: priceNum,
        cost: Number(productForm.cost),
        stock: stockNum,
        threshold: threshNum,
        status,
        views: 120,
        conversions: 0,
        image: productForm.image,
        description: productForm.description
      };
      setProducts([newProduct, ...products]);
      showToast(`Exquisite piece "${productForm.title}" added to catalog.`);
    }
    setIsProductModalOpen(false);
  };

  const handleDeleteProduct = (id, name) => {
    setProducts((prev) => prev.filter((p) => p.id !== id));
    showToast(`Removed "${name}" from archives.`, 'info');
  };

  const handleStockAdjustment = (productId, delta) => {
    setProducts((prev) =>
      prev.map((item) => {
        if (item.id === productId) {
          const newQty = Math.max(0, item.stock + delta);
          let newStatus = 'In Stock';
          if (newQty === 0) newStatus = 'Sold Out';
          else if (newQty <= item.threshold) newStatus = 'Low Stock';
          return { ...item, stock: newQty, status: newStatus };
        }
        return item;
      })
    );
  };

  const handleUpdateOrderStatus = (orderId, newStatus) => {
    setOrders((prev) =>
      prev.map((ord) => (ord.id === orderId ? { ...ord, fulfillmentStatus: newStatus } : ord))
    );
    if (viewingOrder && viewingOrder.id === orderId) {
      setViewingOrder((prev) => ({ ...prev, fulfillmentStatus: newStatus }));
    }
    showToast(`Order ${orderId} updated to: ${newStatus}`);
  };

  const handleSendInquiryReply = (e) => {
    e.preventDefault();
    if (!replyText.trim() || !selectedInquiry) return;

    const newMsg = {
      from: 'admin',
      time: 'Just now',
      text: replyText.trim()
    };

    setInquiries((prev) =>
      prev.map((inq) =>
        inq.id === selectedInquiry.id
          ? {
              ...inq,
              messages: [...inq.messages, newMsg],
              unread: false
            }
          : inq
      )
    );

    setSelectedInquiry((prev) => ({
      ...prev,
      messages: [...prev.messages, newMsg],
      unread: false
    }));

    setReplyText('');
    showToast('Concierge dispatch sent to customer.');
  };

  // Metrics
  const totalRevenue = useMemo(() => orders.reduce((sum, o) => sum + o.total, 0), [orders]);
  const lowStockCount = useMemo(() => products.filter((p) => p.stock <= p.threshold).length, [products]);
  const totalInventoryValue = useMemo(() => products.reduce((sum, p) => sum + p.price * p.stock, 0), [products]);

  // Filtered Products
  const filteredProducts = useMemo(() => {
    return products.filter((p) => {
      const matchesSearch =
        p.name.toLowerCase().includes(productSearch.toLowerCase()) ||
        p.sku.toLowerCase().includes(productSearch.toLowerCase()) ||
        p.gemstone.toLowerCase().includes(productSearch.toLowerCase());
      const matchesCat = selectedCategoryFilter === 'All' || p.category === selectedCategoryFilter;
      return matchesSearch && matchesCat;
    });
  }, [products, productSearch, selectedCategoryFilter]);

  // Filtered Orders
  const filteredOrders = useMemo(() => {
    return orders.filter((o) => {
      const matchSearch =
        o.id.toLowerCase().includes(orderSearch.toLowerCase()) ||
        o.customer.toLowerCase().includes(orderSearch.toLowerCase());
      const matchStatus = orderStatusFilter === 'All' || o.fulfillmentStatus === orderStatusFilter;
      return matchSearch && matchStatus;
    });
  }, [orders, orderSearch, orderStatusFilter]);

  return (
    <div className="flex h-screen w-full bg-[#0F1115] text-[#E4E4E7] font-sans overflow-hidden antialiased selection:bg-[#D4AF37]/30 selection:text-[#FBFBFC]">
      {/* --- TOAST ALERT --- */}
      {toast && (
        <div className="fixed top-5 right-6 z-50 flex items-center gap-3 px-5 py-3 rounded-lg border border-[#D4AF37]/30 bg-[#1A1D24] text-white shadow-2xl backdrop-blur-md animate-fade-in">
          <Sparkle className="w-4 h-4 text-[#D4AF37] animate-spin" />
          <span className="text-sm font-medium tracking-wide">{toast.message}</span>
        </div>
      )}

      {/* --- SIDEBAR NAVIGATION --- */}
      <aside
        className={`relative flex flex-col justify-between border-r border-[#262A33] bg-[#14171E] transition-all duration-300 z-20 ${
          sidebarCollapsed ? 'w-20' : 'w-64'
        }`}
      >
        <div>
          {/* Brand Emblem */}
          <div className="flex items-center gap-3 px-6 py-6 border-b border-[#262A33]">
            <div className="relative flex items-center justify-center w-10 h-10 rounded-lg bg-gradient-to-br from-[#D4AF37] via-[#B89730] to-[#8C6D23] shadow-lg shadow-[#D4AF37]/15">
              <Gem className="w-5 h-5 text-black" />
            </div>
            {!sidebarCollapsed && (
              <div className="overflow-hidden">
                <h1 className="font-serif tracking-wider text-lg font-semibold text-white uppercase">
                  LUMIÈRE
                </h1>
                <p className="text-[10px] tracking-widest text-[#D4AF37] font-light uppercase">
                  Haute Joaillerie
                </p>
              </div>
            )}
          </div>

          {/* Navigation Items */}
          <nav className="p-3 space-y-1">
            {[
              { id: 'overview', label: 'Maison Overview', icon: LayoutDashboard },
              { id: 'products', label: 'Fine Catalog', icon: Gem },
              { id: 'inventory', label: 'Vault Inventory', icon: Boxes },
              { id: 'orders', label: 'Bespoke Orders', icon: ShoppingBag, badge: orders.length },
              { id: 'customers', label: 'Private Clients', icon: Users },
              { id: 'inquiries', label: 'Concierge Inbox', icon: MessageSquare, badge: 2 }
            ].map((nav) => {
              const Icon = nav.icon;
              const isActive = activeTab === nav.id;
              return (
                <button
                  key={nav.id}
                  onClick={() => setActiveTab(nav.id)}
                  className={`w-full flex items-center gap-3.5 px-3.5 py-3 rounded-lg text-sm font-medium transition-all ${
                    isActive
                      ? 'bg-gradient-to-r from-[#D4AF37]/15 to-transparent text-[#EBD79A] border-l-2 border-[#D4AF37]'
                      : 'text-zinc-400 hover:text-zinc-100 hover:bg-[#1E232B]'
                  }`}
                >
                  <Icon className={`w-4 h-4 ${isActive ? 'text-[#D4AF37]' : 'text-zinc-400'}`} />
                  {!sidebarCollapsed && (
                    <span className="flex-1 text-left tracking-wide">{nav.label}</span>
                  )}
                  {!sidebarCollapsed && nav.badge && (
                    <span className="px-1.5 py-0.5 text-[11px] font-semibold bg-[#2A2E39] text-[#D4AF37] rounded-full border border-[#D4AF37]/20">
                      {nav.badge}
                    </span>
                  )}
                </button>
              );
            })}
          </nav>
        </div>

        {/* Sidebar Footer & Collapser */}
        <div className="p-4 border-t border-[#262A33] flex items-center justify-between">
          {!sidebarCollapsed && (
            <div className="flex items-center gap-3">
              <div className="w-8 h-8 rounded-full bg-[#262A33] border border-[#D4AF37]/40 flex items-center justify-center text-xs font-serif text-[#D4AF37]">
                LA
              </div>
              <div>
                <p className="text-xs font-medium text-white">Curator Atelier</p>
                <p className="text-[10px] text-zinc-500">Master Jeweler ID</p>
              </div>
            </div>
          )}
          <button
            onClick={() => setSidebarCollapsed(!sidebarCollapsed)}
            className="p-1.5 rounded-md hover:bg-[#20252E] text-zinc-400 hover:text-white transition-colors"
            title="Toggle Sidebar"
          >
            <ChevronRight
              className={`w-4 h-4 transition-transform duration-200 ${
                sidebarCollapsed ? 'rotate-0' : 'rotate-180'
              }`}
            />
          </button>
        </div>
      </aside>

      {/* --- MAIN CONTENT AREA --- */}
      <main className="flex-1 flex flex-col min-w-0 bg-[#0E1015] overflow-y-auto">
        {/* TOP BAR */}
        <header className="sticky top-0 z-10 flex items-center justify-between px-8 py-4 bg-[#14171E]/80 backdrop-blur-md border-b border-[#262A33]">
          <div className="flex items-center gap-4">
            <span className="text-xs tracking-widest uppercase font-serif text-zinc-400">
              Maison Admin Suite
            </span>
            <span className="text-zinc-600">/</span>
            <span className="text-xs font-medium uppercase tracking-wider text-[#D4AF37]">
              {activeTab}
            </span>
          </div>

          <div className="flex items-center gap-4">
            {/* Live Indicator */}
            <div className="hidden md:flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/40 border border-emerald-500/30 text-emerald-400 text-xs">
              <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Live Salon Visitors: 42
            </div>

            {/* Quick Action Button */}
            <button
              onClick={openNewProductModal}
              className="flex items-center gap-2 px-4 py-2 text-xs font-medium text-black bg-gradient-to-r from-[#DFBF58] via-[#D4AF37] to-[#B38C26] rounded-md shadow-md hover:brightness-110 active:scale-95 transition-all tracking-wider uppercase font-semibold"
            >
              <Plus className="w-3.5 h-3.5 stroke-[2.5]" />
              New Haute Creation
            </button>

            {/* Notification Bell */}
            <div className="relative">
              <button className="p-2 rounded-lg bg-[#1B1F27] border border-[#2B303C] hover:border-[#D4AF37]/50 text-zinc-300 transition-colors">
                <Bell className="w-4 h-4" />
                <span className="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-[#D4AF37]" />
              </button>
            </div>
          </div>
        </header>

        {/* TAB CONTENTS */}
        <div className="p-8 max-w-7xl w-full mx-auto space-y-8">
          {/* =========================================================================
              VIEW 1: OVERVIEW / ANALYTICS
             ========================================================================= */}
          {activeTab === 'overview' && (
            <div className="space-y-8 animate-fade-in">
              {/* Header greeting */}
              <div className="flex flex-col md:flex-row justify-between md:items-end gap-4 border-b border-[#262A33] pb-6">
                <div>
                  <h2 className="text-2xl font-serif text-white tracking-wide">
                    Atelier Executive Overview
                  </h2>
                  <p className="text-sm text-zinc-400 mt-1">
                    Real-time salon performance, VIP client inquiries & vault status.
                  </p>
                </div>
                <div className="flex items-center gap-2 text-xs text-zinc-400 bg-[#161921] px-3.5 py-2 rounded-lg border border-[#262A33]">
                  <Calendar className="w-3.5 h-3.5 text-[#D4AF37]" />
                  <span>Q4 Fiscal Vault Season • Live Currency: USD ($)</span>
                </div>
              </div>

              {/* KPI Cards */}
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                {[
                  {
                    title: 'Total Monthly Sales',
                    value: `$${totalRevenue.toLocaleString()}`,
                    change: '+18.4% vs last mo.',
                    trend: 'up',
                    icon: DollarSign,
                    subtitle: '74 completed acquisitions'
                  },
                  {
                    title: 'Vault Assets Valuation',
                    value: `$${totalInventoryValue.toLocaleString()}`,
                    change: '16 high pieces reserved',
                    trend: 'neutral',
                    icon: Gem,
                    subtitle: 'Certified stones in custody'
                  },
                  {
                    title: 'Average Order Value (AOV)',
                    value: '$5,980',
                    change: '+11.2% bridal uplift',
                    trend: 'up',
                    icon: TrendingUp,
                    subtitle: 'Top category: Engagement Rings'
                  },
                  {
                    title: 'Low Stock Safeguard',
                    value: `${lowStockCount} Creations`,
                    change: 'Requires artisan casting',
                    trend: 'alert',
                    icon: AlertTriangle,
                    subtitle: 'Threshold ≤ 2 available'
                  }
                ].map((kpi, idx) => {
                  const Icon = kpi.icon;
                  return (
                    <div
                      key={idx}
                      className="p-5 rounded-xl bg-gradient-to-b from-[#181C24] to-[#12151B] border border-[#262A33] hover:border-[#D4AF37]/40 transition-all shadow-lg"
                    >
                      <div className="flex items-center justify-between">
                        <span className="text-xs font-medium text-zinc-400 tracking-wider uppercase">
                          {kpi.title}
                        </span>
                        <div
                          className={`p-2 rounded-lg ${
                            kpi.trend === 'alert'
                              ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
                              : 'bg-[#232834] text-[#D4AF37]'
                          }`}
                        >
                          <Icon className="w-4 h-4" />
                        </div>
                      </div>
                      <div className="mt-3">
                        <div className="text-2xl font-serif text-white font-semibold tracking-tight">
                          {kpi.value}
                        </div>
                        <div className="flex items-center gap-1.5 mt-2">
                          {kpi.trend === 'up' && (
                            <ArrowUpRight className="w-3.5 h-3.5 text-emerald-400" />
                          )}
                          {kpi.trend === 'alert' && (
                            <AlertTriangle className="w-3.5 h-3.5 text-amber-400" />
                          )}
                          <span
                            className={`text-xs ${
                              kpi.trend === 'up'
                                ? 'text-emerald-400 font-medium'
                                : kpi.trend === 'alert'
                                ? 'text-amber-400'
                                : 'text-zinc-400'
                            }`}
                          >
                            {kpi.change}
                          </span>
                        </div>
                        <p className="text-[11px] text-zinc-500 mt-1">{kpi.subtitle}</p>
                      </div>
                    </div>
                  );
                })}
              </div>

              {/* Charts Section */}
              <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {/* Revenue Growth Chart */}
                <div className="lg:col-span-2 p-6 rounded-xl bg-[#14171E] border border-[#262A33]">
                  <div className="flex items-center justify-between mb-6">
                    <div>
                      <h3 className="font-serif text-base text-white">Revenue Performance (6-Month Trajectory)</h3>
                      <p className="text-xs text-zinc-400">Total volume from high jewelry and online orders</p>
                    </div>
                    <span className="text-xs px-2.5 py-1 bg-[#1F232D] text-[#D4AF37] border border-[#D4AF37]/30 rounded">
                      Audited Currency (USD)
                    </span>
                  </div>
                  <div className="h-64 w-full">
                    <ResponsiveContainer width="100%" height="100%">
                      <AreaChart data={REVENUE_DATA} margin={{ top: 10, right: 10, left: 0, bottom: 0 }}>
                        <defs>
                          <linearGradient id="goldGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stopColor="#D4AF37" stopOpacity={0.35} />
                            <stop offset="95%" stopColor="#D4AF37" stopOpacity={0} />
                          </linearGradient>
                        </defs>
                        <CartesianGrid strokeDasharray="3 3" stroke="#232732" vertical={false} />
                        <XAxis dataKey="month" stroke="#686F7E" fontSize={11} tickLine={false} />
                        <YAxis
                          stroke="#686F7E"
                          fontSize={11}
                          tickLine={false}
                          tickFormatter={(val) => `$${val / 1000}k`}
                        />
                        <Tooltip
                          contentStyle={{
                            backgroundColor: '#181C24',
                            borderColor: '#363C4A',
                            borderRadius: 8,
                            fontSize: 12
                          }}
                          formatter={(value) => [`$${value.toLocaleString()}`, 'Revenue']}
                        />
                        <Area
                          type="monotone"
                          dataKey="revenue"
                          stroke="#D4AF37"
                          strokeWidth={2.5}
                          fillOpacity={1}
                          fill="url(#goldGradient)"
                        />
                      </AreaChart>
                    </ResponsiveContainer>
                  </div>
                </div>

                {/* Category Revenue Distribution */}
                <div className="p-6 rounded-xl bg-[#14171E] border border-[#262A33] flex flex-col justify-between">
                  <div>
                    <h3 className="font-serif text-base text-white">Share by Category</h3>
                    <p className="text-xs text-zinc-400 mb-4">Volume generated per jewelry department</p>
                    <div className="h-44 w-full">
                      <ResponsiveContainer width="100%" height="100%">
                        <PieChart>
                          <Pie
                            data={CATEGORY_SHARE}
                            innerRadius={50}
                            outerRadius={75}
                            paddingAngle={5}
                            dataKey="value"
                          >
                            {CATEGORY_SHARE.map((entry, index) => (
                              <Cell key={`cell-${index}`} fill={entry.color} />
                            ))}
                          </Pie>
                          <Tooltip
                            contentStyle={{
                              backgroundColor: '#181C24',
                              borderColor: '#363C4A',
                              borderRadius: 8,
                              fontSize: 12
                            }}
                            formatter={(v) => [`${v}%`, 'Category Share']}
                          />
                        </PieChart>
                      </ResponsiveContainer>
                    </div>
                  </div>
                  <div className="space-y-2 mt-2 pt-2 border-t border-[#232834]">
                    {CATEGORY_SHARE.map((cat, i) => (
                      <div key={i} className="flex items-center justify-between text-xs">
                        <div className="flex items-center gap-2">
                          <span className="w-2.5 h-2.5 rounded-full" style={{ backgroundColor: cat.color }} />
                          <span className="text-zinc-300">{cat.name}</span>
                        </div>
                        <span className="font-mono text-zinc-400">{cat.value}%</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              {/* Lower Section: Recent Orders & Low Stock Quick Alert */}
              <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {/* Recent High Value Orders */}
                <div className="lg:col-span-2 p-6 rounded-xl bg-[#14171E] border border-[#262A33]">
                  <div className="flex items-center justify-between mb-4">
                    <h3 className="font-serif text-base text-white">Recent Atelier Orders</h3>
                    <button
                      onClick={() => setActiveTab('orders')}
                      className="text-xs text-[#D4AF37] hover:underline flex items-center gap-1"
                    >
                      View All Orders <ChevronRight className="w-3 h-3" />
                    </button>
                  </div>
                  <div className="divide-y divide-[#232732]">
                    {orders.slice(0, 3).map((ord) => (
                      <div
                        key={ord.id}
                        onClick={() => {
                          setViewingOrder(ord);
                          setActiveTab('orders');
                        }}
                        className="py-3.5 flex items-center justify-between hover:bg-[#1A1E26] px-2 rounded-lg cursor-pointer transition-colors"
                      >
                        <div className="flex items-center gap-3">
                          <div className="w-9 h-9 rounded-md bg-[#212632] flex items-center justify-center text-[#D4AF37]">
                            <ShoppingBag className="w-4 h-4" />
                          </div>
                          <div>
                            <p className="text-sm font-medium text-white">{ord.customer}</p>
                            <p className="text-xs text-zinc-400">
                              {ord.items[0]?.name} {ord.items.length > 1 && `+${ord.items.length - 1} more`}
                            </p>
                          </div>
                        </div>
                        <div className="text-right">
                          <p className="text-sm font-mono text-white">${ord.total.toLocaleString()}</p>
                          <span className="inline-block mt-0.5 text-[10px] px-2 py-0.5 rounded-full bg-[#272D3B] text-[#D4AF37] border border-[#D4AF37]/30">
                            {ord.fulfillmentStatus}
                          </span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                {/* Vault Replenishment / Stock Alert */}
                <div className="p-6 rounded-xl bg-[#14171E] border border-[#262A33] flex flex-col justify-between">
                  <div>
                    <div className="flex items-center gap-2 text-amber-400 text-xs font-semibold tracking-wider uppercase mb-2">
                      <AlertTriangle className="w-4 h-4" />
                      <span>Stock Attention</span>
                    </div>
                    <h3 className="font-serif text-base text-white">Pieces Nearing Depletion</h3>
                    <p className="text-xs text-zinc-400 mt-1 mb-4">
                      Pieces below reserved showroom threshold
                    </p>
                    <div className="space-y-3">
                      {products
                        .filter((p) => p.stock <= p.threshold)
                        .map((p) => (
                          <div
                            key={p.id}
                            className="p-3 rounded-lg bg-[#191D26] border border-[#282E3C] flex items-center justify-between"
                          >
                            <div>
                              <p className="text-xs font-medium text-white line-clamp-1">{p.name}</p>
                              <p className="text-[11px] text-zinc-400 font-mono">
                                Stock: <span className="text-amber-400 font-bold">{p.stock}</span> (Min: {p.threshold})
                              </p>
                            </div>
                            <button
                              onClick={() => {
                                handleStockAdjustment(p.id, 1);
                                showToast(`Replenished 1 unit for ${p.name}`);
                              }}
                              className="px-2.5 py-1 text-xs bg-[#2B303C] hover:bg-[#D4AF37] hover:text-black rounded text-zinc-200 transition-colors"
                            >
                              +1 Unit
                            </button>
                          </div>
                        ))}
                    </div>
                  </div>
                  <button
                    onClick={() => setActiveTab('inventory')}
                    className="w-full mt-4 py-2 text-xs text-center border border-[#333948] hover:border-[#D4AF37] text-zinc-300 rounded transition-colors"
                  >
                    Manage Vault Replenishment
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* =========================================================================
              VIEW 2: PRODUCT CATALOG MANAGEMENT
             ========================================================================= */}
          {activeTab === 'products' && (
            <div className="space-y-6 animate-fade-in">
              <div className="flex flex-col sm:flex-row justify-between sm:items-center gap-4">
                <div>
                  <h2 className="text-2xl font-serif text-white tracking-wide">Fine Jewelry Catalog</h2>
                  <p className="text-sm text-zinc-400">
                    Curate diamond specs, gemstone certificates, precious metals, and pricing.
                  </p>
                </div>
                <button
                  onClick={openNewProductModal}
                  className="flex items-center gap-2 px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-black bg-gradient-to-r from-[#DFBF58] via-[#D4AF37] to-[#B38C26] rounded-md shadow hover:brightness-110 active:scale-95 transition-all"
                >
                  <Plus className="w-4 h-4 stroke-[2.5]" />
                  Add Jewelry Creation
                </button>
              </div>

              {/* Filters & Search */}
              <div className="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 bg-[#14171E] p-3 rounded-xl border border-[#262A33]">
                <div className="relative flex-1">
                  <Search className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-500" />
                  <input
                    type="text"
                    value={productSearch}
                    onChange={(e) => setProductSearch(e.target.value)}
                    placeholder="Search by gemstone, SKU (e.g. AUR-RNG), or design title..."
                    className="w-full bg-[#181C25] pl-10 pr-4 py-2 text-xs rounded-lg border border-[#2B303C] focus:outline-none focus:border-[#D4AF37] text-white placeholder-zinc-500"
                  />
                </div>
                <div className="flex items-center gap-2 overflow-x-auto pb-1 md:pb-0">
                  {['All', 'Rings', 'Necklaces', 'Earrings', 'Bracelets'].map((cat) => (
                    <button
                      key={cat}
                      onClick={() => setSelectedCategoryFilter(cat)}
                      className={`px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-colors ${
                        selectedCategoryFilter === cat
                          ? 'bg-[#D4AF37] text-black font-semibold'
                          : 'bg-[#1C202A] text-zinc-400 hover:text-white border border-[#2A2F3D]'
                      }`}
                    >
                      {cat}
                    </button>
                  ))}
                </div>
              </div>

              {/* Products Table */}
              <div className="rounded-xl border border-[#262A33] bg-[#14171E] overflow-hidden shadow-xl">
                <div className="overflow-x-auto">
                  <table className="w-full text-left text-xs">
                    <thead className="bg-[#181B23] border-b border-[#262A33] text-zinc-400 uppercase tracking-wider font-medium text-[11px]">
                      <tr>
                        <th className="py-3.5 px-4">Creation & SKU</th>
                        <th className="py-3.5 px-4">Category / Metal</th>
                        <th className="py-3.5 px-4">Gemstone & 4Cs</th>
                        <th className="py-3.5 px-4">Vault Status</th>
                        <th className="py-3.5 px-4">Price</th>
                        <th className="py-3.5 px-4">Views / Demand</th>
                        <th className="py-3.5 px-4 text-right">Actions</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-[#232732]">
                      {filteredProducts.map((p) => (
                        <tr key={p.id} className="hover:bg-[#181C24] transition-colors group">
                          {/* Image & Title */}
                          <td className="py-3.5 px-4">
                            <div className="flex items-center gap-3">
                              <img
                                src={p.image}
                                alt={p.name}
                                className="w-12 h-12 object-cover rounded-md border border-[#2F3442]"
                              />
                              <div>
                                <p className="font-serif text-sm text-white font-medium group-hover:text-[#D4AF37] transition-colors">
                                  {p.name}
                                </p>
                                <span className="text-[11px] font-mono text-zinc-400">{p.sku}</span>
                              </div>
                            </div>
                          </td>

                          {/* Category & Metal */}
                          <td className="py-3.5 px-4">
                            <p className="text-white font-medium">{p.category}</p>
                            <p className="text-zinc-400 text-[11px]">{p.metal}</p>
                          </td>

                          {/* Gemstone specs */}
                          <td className="py-3.5 px-4">
                            <div className="flex items-center gap-1.5 text-zinc-200">
                              <Sparkles className="w-3 h-3 text-[#D4AF37]" />
                              <span className="font-medium">{p.gemstone}</span>
                            </div>
                            <p className="text-[11px] text-zinc-400">
                              {p.carat} • {p.clarity} • {p.color}
                            </p>
                          </td>

                          {/* Stock Status */}
                          <td className="py-3.5 px-4">
                            <span
                              className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-medium border ${
                                p.status === 'In Stock'
                                  ? 'bg-emerald-950/40 text-emerald-300 border-emerald-700/40'
                                  : p.status === 'Low Stock'
                                  ? 'bg-amber-950/40 text-amber-300 border-amber-700/40'
                                  : 'bg-rose-950/40 text-rose-300 border-rose-700/40'
                              }`}
                            >
                              <span
                                className={`w-1.5 h-1.5 rounded-full ${
                                  p.status === 'In Stock'
                                    ? 'bg-emerald-400'
                                    : p.status === 'Low Stock'
                                    ? 'bg-amber-400'
                                    : 'bg-rose-400'
                                }`}
                              />
                              {p.stock} available ({p.status})
                            </span>
                          </td>

                          {/* Price & Cost Margin */}
                          <td className="py-3.5 px-4">
                            <p className="font-mono text-white font-medium text-sm">
                              ${p.price.toLocaleString()}
                            </p>
                            <p className="text-[10px] text-zinc-500">
                              Cost: ${p.cost.toLocaleString()} (
                              {Math.round(((p.price - p.cost) / p.price) * 100)}% margin)
                            </p>
                          </td>

                          {/* Views */}
                          <td className="py-3.5 px-4">
                            <div className="flex items-center gap-1.5 text-zinc-300">
                              <Eye className="w-3.5 h-3.5 text-zinc-500" />
                              <span>{p.views.toLocaleString()}</span>
                            </div>
                            <span className="text-[10px] text-zinc-500">
                              {p.conversions} direct inquiries
                            </span>
                          </td>

                          {/* Actions */}
                          <td className="py-3.5 px-4 text-right">
                            <div className="flex items-center justify-end gap-1">
                              <button
                                onClick={() => openEditProductModal(p)}
                                title="Edit Specifications"
                                className="p-1.5 text-zinc-400 hover:text-[#D4AF37] hover:bg-[#202530] rounded transition-colors"
                              >
                                <Edit3 className="w-3.5 h-3.5" />
                              </button>
                              <button
                                onClick={() => handleDeleteProduct(p.id, p.name)}
                                title="Archive Piece"
                                className="p-1.5 text-zinc-400 hover:text-rose-400 hover:bg-[#202530] rounded transition-colors"
                              >
                                <Trash2 className="w-3.5 h-3.5" />
                              </button>
                            </div>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          )}

          {/* =========================================================================
              VIEW 3: INVENTORY & STOCK MANAGEMENT
             ========================================================================= */}
          {activeTab === 'inventory' && (
            <div className="space-y-6 animate-fade-in">
              <div className="flex flex-col sm:flex-row justify-between sm:items-center gap-4">
                <div>
                  <h2 className="text-2xl font-serif text-white tracking-wide">
                    Vault & Showroom Inventory
                  </h2>
                  <p className="text-sm text-zinc-400">
                    Real-time count, minimum threshold governance, and quick adjustments.
                  </p>
                </div>
                <div className="flex items-center gap-3">
                  <div className="px-4 py-2 rounded-lg bg-[#191D26] border border-[#2B303E] text-xs">
                    <span className="text-zinc-400">Total Units in Vault: </span>
                    <span className="font-mono font-bold text-[#D4AF37]">
                      {products.reduce((acc, p) => acc + p.stock, 0)}
                    </span>
                  </div>
                </div>
              </div>

              {/* Replenishment Grid */}
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                {products.map((p) => (
                  <div
                    key={p.id}
                    className={`p-5 rounded-xl border transition-all ${
                      p.stock <= p.threshold
                        ? 'bg-[#181514] border-amber-500/30 shadow-lg shadow-amber-950/20'
                        : 'bg-[#14171E] border-[#262A33]'
                    }`}
                  >
                    <div className="flex items-start gap-3">
                      <img
                        src={p.image}
                        alt={p.name}
                        className="w-14 h-14 object-cover rounded-lg border border-[#2A2F3D]"
                      />
                      <div className="flex-1 min-w-0">
                        <span className="text-[10px] font-mono text-[#D4AF37] uppercase">{p.sku}</span>
                        <h4 className="text-sm font-medium text-white truncate">{p.name}</h4>
                        <p className="text-xs text-zinc-400">{p.metal}</p>
                      </div>
                    </div>

                    <div className="my-4 pt-3 border-t border-[#232732] flex items-center justify-between">
                      <div>
                        <span className="text-[11px] text-zinc-500">Vault Level</span>
                        <div className="text-xl font-bold font-mono text-white flex items-center gap-2">
                          {p.stock}
                          <span className="text-xs font-normal text-zinc-400">units</span>
                        </div>
                      </div>
                      <div className="text-right">
                        <span className="text-[11px] text-zinc-500">Alert Trigger</span>
                        <div className="text-xs font-mono text-zinc-300">≤ {p.threshold} units</div>
                      </div>
                    </div>

                    {/* Quick Adjust Buttons */}
                    <div className="flex items-center gap-2">
                      <button
                        onClick={() => handleStockAdjustment(p.id, -1)}
                        disabled={p.stock <= 0}
