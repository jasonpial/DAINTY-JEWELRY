rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Primitives
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // Entity Blueprint: UserProfile (/users/{userId})
    // Mirrors firebase-blueprint.json verbatim bounds
    // -------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return (
        data.keys().hasAll(['uid', 'name', 'email', 'provider', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'address', 'provider', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        data.provider is string && data.provider.size() <= 20 && data.provider in ['google', 'password'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp
      );
    }

    // -------------------------------------------------------------------------
    // Collection Rules: /users/{userId}
    // Strict owner-only PII isolation, zero blanket reads or list scraping
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if (
        isSignedIn() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time
      );

      allow update: if (
        isSignedIn() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Patron Profile & Delivery Preferences Update
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'address', 'updatedAt']) ||
          // Action 2: Login Provider / Display Sync
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'provider', 'updatedAt'])
        )
      );

      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
